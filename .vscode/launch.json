{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: GUI",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "pnpm",
            "restart": true,
            "timeout": 30000,
            "runtimeArgs": [
                "start"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/packages/gui/build/**/*.js",
                "${workspaceFolder}/packages/*/dist/**/*.js",
                "${workspaceFolder}/packages/gui/.webpack/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "sourceMaps": true,
            "serverReadyAction": {
                "pattern": "Project is running at:",
                "uriFormat": "http://localhost:8601",
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "webRoot": "${workspaceFolder}/packages/gui"
            },
            "env": {
                "BROWSER": "none",
                "NODE_ENV": "development"
            },
            "console": "integratedTerminal",
            "outputCapture": "std"
        },
        {
            "name": "Debug: Block",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "pnpm",
            "restart": true,
            "timeout": 30000,
            "runtimeArgs": [
                "block",
                "start"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/packages/block/build/**/*.js",
                "${workspaceFolder}/packages/*/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "sourceMaps": true,
            "serverReadyAction": {
                "pattern": "Project is running at:",
                "uriFormat": "http://localhost:8071",
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "webRoot": "${workspaceFolder}/packages/block"
            },
            "env": {
                "BROWSER": "none",
                "NODE_ENV": "development"
            },
            "console": "integratedTerminal",
            "outputCapture": "std"
        }
    ]
}
