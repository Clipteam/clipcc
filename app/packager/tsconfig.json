{
  "include": [
    "src"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "noEmit": true,
    "strict": true
  }
}
