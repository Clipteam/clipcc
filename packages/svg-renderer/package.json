{
  "name": "clipcc-svg-renderer",
  "version": "3.2.0",
  "description": "SVG renderer for ClipCC",
  "main": "./src/index.js",
  "browser": "./dist/web/scratch-svg-renderer.js",
  "exports": {
    "webpack": "./src/index.js",
    "browser": "./dist/web/scratch-svg-renderer.js",
    "default": "./src/index.js"
  },
  "scripts": {
    "build": "yarn run clean && webpack",
    "clean": "rimraf ./dist",
    "start": "webpack-dev-server",
    "test": "yarn run test:lint && yarn run test:unit",
    "test:lint": "eslint . --ext .js",
    "test:unit": "tap ./test/*.js --allow-incomplete-coverage --allow-empty-coverage",
    "watch": "webpack --watch"
  },
  "author": "Massachusetts Institute of Technology",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Clipteam/clipcc/packages/svg-renderer#readme",
  "peerDependencies": {
    "scratch-render-fonts": "^1.0.0"
  },
  "dependencies": {
    "base64-js": "^1.2.1",
    "base64-loader": "^1.0.0",
    "css-tree": "^1.1.3",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "isomorphic-dompurify": "^2.4.0",
    "minilog": "^3.1.0",
    "transformation-matrix": "^1.15.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.24.8",
    "@babel/cli": "7.14.8",
    "@babel/core": "7.14.8",
    "@babel/eslint-parser": "7.18.2",
    "babel-core": "7.0.0-bridge.0",
    "babel-loader": "9.1.3",
    "copy-webpack-plugin": "4.6.0",
    "eslint": "8.57.0",
    "eslint-config-scratch": "9.0.8",
    "eslint-plugin-import": "2.29.1",
    "husky": "8.0.3",
    "jsdom": "13.2.0",
    "json": "9.0.6",
    "mkdirp": "2.1.6",
    "rimraf": "3.0.2",
    "scratch-render-fonts": "1.0.73",
    "scratch-semantic-release-config": "1.0.14",
    "semantic-release": "19.0.5",
    "tap": "21.0.1",
    "webpack": "5.93.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "3.11.3",
    "xmldom": "0.1.31"
  },
  "browserslist": [
    "Chrome >= 63",
    "Edge >= 15",
    "Firefox >= 57",
    "Safari >= 11"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
