{
  "name": "clipcc-svg-renderer",
  "version": "3.2.0",
  "description": "SVG renderer for ClipCC",
  "main": "./dist/node/index.js",
  "browser": "./dist/web/scratch-svg-renderer.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "node": "./dist/node/index.js",
      "browser": "./dist/web/scratch-svg-renderer.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "yarn run clean && tsc --project ./tsconfig.node.json && webpack",
    "clean": "rimraf dist playground",
    "start": "webpack-dev-server",
    "test": "yarn run test:types && yarn run test:lint && yarn run test:unit",
    "test:types": "tsc --noEmit",
    "test:lint": "eslint . --ext .ts",
    "test:unit": "tap ./test/*.ts --allow-incomplete-coverage --allow-empty-coverage",
    "watch": "webpack --watch"
  },
  "author": "Clip Team",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Clipteam/clipcc/packages/svg-renderer#readme",
  "peerDependencies": {
    "scratch-render-fonts": "1.0.252"
  },
  "dependencies": {
    "@turbowarp/nanolog": "^0.2.0",
    "base64-js": "^1.5.1",
    "base64-loader": "^1.0.0",
    "css-tree": "^1.1.3",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "isomorphic-dompurify": "^2.35.0",
    "transformation-matrix": "^2.16.1"
  },
  "devDependencies": {
    "@babel/cli": "7.28.3",
    "@babel/core": "7.28.5",
    "@babel/eslint-parser": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@types/css-tree": "^2.3.8",
    "@types/jsdom": "^21.1.7",
    "@types/xmldom": "^0.1.34",
    "babel-core": "7.0.0-bridge.0",
    "babel-loader": "9.2.1",
    "copy-webpack-plugin": "4.6.0",
    "eslint": "^9.39.2",
    "eslint-config-clipcc": "9.0.9",
    "eslint-plugin-import": "2.29.1",
    "globals": "^16.5.0",
    "husky": "8.0.3",
    "jsdom": "13.2.0",
    "mkdirp": "2.1.6",
    "rimraf": "3.0.2",
    "scratch-render-fonts": "1.0.252",
    "tap": "21.0.1",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "5.104.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2",
    "xmldom": "0.1.31"
  },
  "browserslist": [
    "Chrome >= 63",
    "Edge >= 15",
    "Firefox >= 57",
    "Safari >= 11"
  ]
}
