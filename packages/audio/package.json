{
  "name": "clipcc-audio",
  "version": "3.2.0",
  "description": "audio engine for scratch 3.0",
  "main": "dist.js",
  "browser": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "test": "pnpm run lint && pnpm run tap && pnpm run build",
    "build:types": "tsc --project ./tsconfig.dts.json",
    "build": "pnpm run build:types && webpack --bail",
    "watch": "webpack --watch",
    "lint": "eslint .",
    "tap": "tap test/effects/*.js test/*.js --allow-incomplete-coverage --allow-empty-coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/Clipteam/clipcc/issues"
  },
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "dependencies": {
    "@turbowarp/nanolog": "^1.0.1",
    "audio-context": "1.0.3",
    "babel-loader": "^10.1.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "startaudiocontext": "1.2.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/eslint-parser": "7.28.6",
    "@babel/preset-env": "7.29.0",
    "babel-eslint": "10.0.3",
    "eslint": "^9.39.2",
    "eslint-config-clipcc": "workspace:*",
    "tap": "21.0.1",
    "typescript": "^5.9.3",
    "web-audio-test-api": "0.5.2",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1"
  }
}
