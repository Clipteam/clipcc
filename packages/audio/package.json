{
  "name": "clipcc-audio",
  "version": "3.2.0",
  "description": "audio engine for scratch 3.0",
  "main": "./dist/dist.js",
  "browser": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "test": "yarn run lint && yarn run tap && yarn run build",
    "build:types": "tsc --project ./tsconfig.dts.json",
    "build": "yarn build:types && webpack --bail",
    "watch": "webpack --watch",
    "lint": "eslint .",
    "tap": "tap test/effects/*.js test/*.js --allow-incomplete-coverage --allow-empty-coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "author": "Clip Team",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/Clipteam/clipcc/issues"
  },
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "dependencies": {
    "@turbowarp/nanolog": "^0.2.0",
    "audio-context": "1.0.3",
    "startaudiocontext": "1.2.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/eslint-parser": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "babel-eslint": "10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-clipcc": "^9.0.9",
    "tap": "21.0.1",
    "typescript": "^5.9.3",
    "web-audio-test-api": "0.5.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
