{
  "name": "clipcc-parser",
  "description": "Parser for Scratch projects",
  "author": "MIT Media Lab",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "scripts": {
    "lint": "eslint . --ext=js",
    "test:unit": "tap --reporter=tap test/unit/*.js --allow-incomplete-coverage --allow-empty-coverage",
    "test:integration": "tap --reporter=tap test/integration/*.js --allow-incomplete-coverage --allow-empty-coverage",
    "test:coverage": "tap --reporter=tap test/{unit,integration}/*.js --coverage --coverage-report=lcov",
    "test:benchmark": "node test/benchmark/performance.js",
    "test": "pnpm run test:unit && pnpm run test:integration"
  },
  "dependencies": {
    "ajv": "6.3.0",
    "jszip": "3.10.1",
    "pify": "4.0.1"
  },
  "devDependencies": {
    "babel-eslint": "8.2.2",
    "benchmark": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-config-clipcc": "workspace:*",
    "glob": "^13.0.6",
    "tap": "^21.0.1"
  },
  "engines": {
    "node": ">=22.0"
  },
  "version": "3.2.0"
}
