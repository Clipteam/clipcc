{
  "name": "clipcc-parser",
  "description": "Parser for Scratch projects",
  "author": "Clip Team",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "scripts": {
    "test:lint": "eslint . --ext=js",
    "test:unit": "tap test/unit/*.js --allow-incomplete-coverage --allow-empty-coverage",
    "test:integration": "tap test/integration/*.js --allow-incomplete-coverage --allow-empty-coverage",
    "test:coverage": "tap test/{unit,integration}/*.js --coverage --coverage-report=lcov",
    "test:benchmark": "node test/benchmark/performance.js",
    "test": "yarn run test:lint && yarn run test:unit && yarn run test:integration"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jszip": "3.10.1",
    "pify": "^6.1.0"
  },
  "devDependencies": {
    "babel-eslint": "8.2.2",
    "benchmark": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-config-clipcc": "^9.0.9",
    "glob": "^7.0.6",
    "husky": "0.14.3",
    "tap": "^21.0.1"
  },
  "engines": {
    "node": ">=22.0"
  },
  "version": "3.2.0"
}
