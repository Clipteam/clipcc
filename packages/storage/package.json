{
  "name": "clipcc-storage",
  "version": "3.2.0",
  "description": "Load and store project and asset files for Scratch 3.0",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "exports": {
    "types": "./dist/types/index.d.ts",
    "webpack": "./src/index.ts",
    "node": "./dist/node/scratch-storage.js",
    "browser": "./dist/web/scratch-storage.js",
    "default": "./dist/node/scratch-storage.js"
  },
  "scripts": {
    "build:types": "tsc --project ./tsconfig.dts.json",
    "build": "rimraf dist && pnpm build:types && webpack --mode=production",
    "coverage": "tap ./test/{unit,integration}/*.js --coverage --coverage-report=lcov",
    "test": "pnpm run test:lint && jest \"test[\\\\/](unit|integration)\"",
    "test:clearCache": "jest --clearCache",
    "test:integration": "jest \"test[\\\\/]integration\"",
    "test:lint": "eslint .",
    "test:unit": "jest \"test[\\\\/]unit\"",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\"",
    "watch": "webpack --watch"
  },
  "tap": {
    "check-coverage": false
  },
  "dependencies": {
    "@babel/runtime": "^7.21.0",
    "@turbowarp/nanolog": "^1.0.1",
    "base64-js": "^1.3.0",
    "cross-fetch": "^4.0.0",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "js-md5": "^0.8.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-transform-runtime": "7.29.0",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "29.5.14",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "arraybuffer-loader": "^1.0.3",
    "babel-loader": "^10.1.1",
    "buffer": "6.0.3",
    "eslint": "^9.39.2",
    "eslint-config-clipcc": "workspace:*",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-react": "7.37.5",
    "jest": "catalog:",
    "json": "^9.0.6",
    "node-fetch": "^3.3.2",
    "rimraf": "6.0.1",
    "ts-jest": "^29.4.5",
    "ts-jest-mock-import-meta": "1.2.1",
    "typescript": "catalog:",
    "webpack": "catalog:",
    "webpack-cli": "6.0.1"
  }
}
