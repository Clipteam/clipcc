{
  "name": "clipcc-storage",
  "version": "3.2.0",
  "description": "Load and store project and asset files for Scratch 3.0",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "main": "./dist/node/scratch-storage.js",
  "browser": "./src/index.js",
  "scripts": {
    "build": "webpack --progress --color --bail",
    "coverage": "tap ./test/{unit,integration}/*.js --coverage --coverage-report=lcov",
    "lint": "eslint .",
    "tap-integration": "tap ./test/integration/*.js --disable-coverage",
    "tap-unit": "tap ./test/unit/*.js --disable-coverage",
    "tap": "yarn run tap-unit && yarn run tap-integration",
    "test": "yarn run tap",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\"",
    "watch": "webpack --progress --colors --watch",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "arraybuffer-loader": "^1.0.3",
    "base64-js": "1.3.0",
    "fastestsmallesttextencoderdecoder": "^1.0.7",
    "js-md5": "0.7.3",
    "minilog": "3.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.14.8",
    "@babel/eslint-parser": "7.18.2",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "7.14.8",
    "@commitlint/cli": "8.2.0",
    "@commitlint/config-conventional": "8.2.0",
    "@commitlint/travis-cli": "8.2.0",
    "babel-eslint": "10.1.0",
    "babel-loader": "^9.1.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "7.27.0",
    "eslint-config-scratch": "^9.0.8",
    "eslint-plugin-react": "7.24.0",
    "husky": "1.3.1",
    "json": "^9.0.4",
    "node-fetch": "2.6.1",
    "node-polyfill-webpack-plugin": "^2.0.1",
    "semantic-release": "^15.10.5",
    "tap": "21.0.1",
    "terser-webpack-plugin": "^5.3.6",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release": {
    "branch": "develop"
  }
}
