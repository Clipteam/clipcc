{
  "name": "clipcc-render",
  "version": "3.2.0",
  "description": "WebGL Renderer for Scratch 3.0",
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "browser": "./dist/web/scratch-render.js",
  "scripts": {
    "build:types": "tsc --project ./tsconfig.dts.json",
    "build": "yarn build:types && webpack --progress --color",
    "clean": "rimraf dist playground",
    "docs": "jsdoc -c .jsdoc.json",
    "lint": "eslint .",
    "prepublish": "yarn run build",
    "prepublish-watch": "yarn run watch",
    "start": "webpack-dev-server",
    "tap": "tap test/unit test/integration --allow-incomplete-coverage --allow-empty-coverage",
    "test": "yarn run lint && yarn run tap",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\"",
    "watch": "webpack --progress --color --watch --watch-poll"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/eslint-parser": "7.27.0",
    "@babel/preset-env": "7.26.9",
    "@types/hull.js": "^1.0.4",
    "babel-core": "7.0.0-bridge.0",
    "babel-loader": "^9.2.1",
    "clipcc-vm": "3.2.0",
    "copy-webpack-plugin": "^11.0.0",
    "docdash": "0.4.0",
    "eslint": "^8.57.0",
    "eslint-config-clipcc": "^9.0.9",
    "gh-pages": "1.2.0",
    "jsdoc": "4.0.0",
    "json": "9.0.6",
    "node-polyfill-webpack-plugin": "^2.0.1",
    "playwright-chromium": "1.57.0",
    "scratch-render-fonts": "1.0.252",
    "tap": "21.0.1",
    "terser-webpack-plugin": "^5.3.16",
    "travis-after-all": "1.4.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "peerDependencies": {
    "scratch-render-fonts": "1.0.252"
  },
  "dependencies": {
    "@turbowarp/nanolog": "^0.2.0",
    "clipcc-storage": "3.2.0",
    "clipcc-svg-renderer": "3.2.0",
    "grapheme-breaker": "0.3.2",
    "hull.js": "0.2.10",
    "ify-loader": "1.1.0",
    "linebreak": "0.3.0",
    "twgl.js": "4.24.0"
  }
}
