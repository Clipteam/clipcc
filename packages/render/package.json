{
  "name": "clipcc-render",
  "version": "3.2.0",
  "description": "WebGL Renderer for Scratch 3.0",
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "exports": {
    "types": "./dist/types/index.d.ts",
    "webpack": "./src/index.js",
    "node": "./dist/node/scratch-render.js",
    "browser": "./dist/web/scratch-render.js",
    "default": "./src/index.js"
  },
  "scripts": {
    "build:types": "tsc --project ./tsconfig.dts.json",
    "build": "pnpm run build:types && webpack --progress --color",
    "lint": "eslint .",
    "prepublish": "pnpm run build",
    "prepublish-watch": "pnpm run watch",
    "start": "webpack-dev-server",
    "tap": "tap --reporter=tap test/unit test/integration --allow-incomplete-coverage --allow-empty-coverage",
    "test": "pnpm run lint && pnpm run tap",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\"",
    "watch": "webpack --progress --color --watch --watch-poll"
  },
  "devDependencies": {
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@types/hull.js": "^1.0.4",
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "10.1.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.39.2",
    "eslint-config-clipcc": "workspace:*",
    "globals": "^16.5.0",
    "json": "9.0.6",
    "node-polyfill-webpack-plugin": "^3.0.0",
    "playwright-chromium": "1.13.0",
    "rule-inheritance-webpack-plugin": "catalog:",
    "scratch-render-fonts": "1.0.252",
    "tap": "21.0.1",
    "terser-webpack-plugin": "^5.3.17",
    "travis-after-all": "1.4.5",
    "typescript": "catalog:",
    "webpack": "catalog:",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "peerDependencies": {
    "scratch-render-fonts": "^1.0.252"
  },
  "dependencies": {
    "@turbowarp/nanolog": "^1.0.1",
    "clipcc-storage": "workspace:~",
    "clipcc-svg-renderer": "workspace:~",
    "grapheme-breaker": "0.3.2",
    "hull.js": "1.0.6",
    "ify-loader": "1.1.0",
    "linebreak": "0.3.0",
    "twgl.js": "4.24.0"
  }
}
