{
    "presets": [
        ["@babel/preset-env", {
            "targets": {
                "browsers": [
                    "Chrome >= 63",
                    "Edge >= 15",
                    "Firefox >= 57",
                    "Safari >= 11",
                    "Android >= 63",
                    "iOS >= 8"
                ]
            }
        }],
        "@babel/preset-react"
    ]
}
