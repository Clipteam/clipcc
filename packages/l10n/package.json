{
    "name": "clipcc-l10n",
    "version": "3.2.0",
    "description": "Localization for the Scratch 3.0 components",
    "main": "./dist/l10n.js",
    "browser": "./src/index.js",
    "scripts": {
        "build:data": "babel-node scripts/build-data",
        "build": "yarn clean && yarn build:data && webpack --progress --color --bail",
        "clean": "rimraf ./dist ./locales && mkdirp dist locales",
        "lint:js": "eslint . --ext .js",
        "lint:json": "jshint -e .json www editor/blocks editor/extensions editor/interface editor/paint-editor",
        "lint": "yarn lint:js && yarn lint:json",
        "pull:interface": "babel-node scripts/tx-pull-editor clipcc-editor interface ./editor/interface/",
        "pull:paint": "babel-node scripts/tx-pull-editor clipcc-editor paint-editor ./editor/paint-editor/",
        "pull:extensions": "babel-node scripts/tx-pull-editor clipcc-editor extensions ./editor/extensions/",
        "pull:blocks": "babel-node scripts/tx-pull-editor clipcc-editor blocks ./editor/blocks/",
        "pull:editor": "yarn pull:blocks && yarn pull:extensions && yarn pull:interface"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Clipteam/clipcc.git"
    },
    "author": "Massachusetts Institute of Technology",
    "license": "BSD-3-Clause",
    "bugs": {
        "url": "https://github.com/Clipteam/clipcc/issues"
    },
    "homepage": "https://github.com/Clipteam/clipcc#readme",
    "dependencies": {
        "@babel/cli": "^7.1.2",
        "@babel/core": "^7.1.2",
        "babel-plugin-react-intl": "^3.0.1",
        "@transifex/api": "4.2.5",
        "download": "^8.0.0"
    },
    "devDependencies": {
        "@babel/eslint-parser": "7.18.2",
        "@babel/node": "7.2.2",
        "@babel/plugin-proposal-object-rest-spread": "^7.0.0",
        "@babel/plugin-syntax-dynamic-import": "^7.0.0",
        "@babel/plugin-transform-async-to-generator": "^7.1.0",
        "@babel/preset-env": "^7.9.5",
        "@babel/preset-react": "^7.0.0",
        "async": "3.2.3",
        "babel-eslint": "^10.0.1",
        "babel-loader": "^9.1.2",
        "eslint": "8.17.0",
        "eslint-config-clipcc": "^3.2.0",
        "eslint-plugin-import": "2.26.0",
        "eslint-plugin-react": "^7.5.1",
        "format-message-cli": "6.2.1",
        "format-message-parse": "6.2.0",
        "glob": "7.1.3",
        "jshint": "2.9.7",
        "json": "^9.0.6",
        "jsonlint": "1.6.3",
        "lodash.defaultsdeep": "4.6.1",
        "mkdirp": "^0.5.1",
        "p-limit": "2.1.0",
        "p-queue": "3.0.0",
        "rimraf": "^2.6.2",
        "webpack": "^5.75.0",
        "webpack-cli": "^5.0.1"
    }
}
