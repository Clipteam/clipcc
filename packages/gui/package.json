{
  "name": "clipcc-gui",
  "version": "3.2.0",
  "description": "Graphical User Interface for creating and running Scratch 3.0 projects",
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "main": "./dist/scratch-gui.js",
  "scripts": {
    "build": "yarn run clean && webpack --color --bail",
    "clean": "rimraf ./build && mkdirp build && rimraf ./dist && mkdirp dist",
    "i18n:src": "rimraf ./translations/messages/src && babel src > tmp.js && rimraf tmp.js && node ./scripts/build-i18n-src.js ./translations/messages/src ./translations/",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "webpack-dev-server",
    "test": "yarn run test:unit && yarn run test:integration",
    "test:integration": "jest --maxWorkers=4 test[\\\\/]integration",
    "test:unit": "jest test[\\\\/]unit",
    "test:smoke": "jest --runInBand test[\\\\/]smoke",
    "watch": "webpack --color --watch"
  },
  "dependencies": {
    "@microbit/microbit-universal-hex": "0.2.2",
    "arraybuffer-loader": "1.0.8",
    "autoprefixer": "^9.0.1",
    "balance-text": "3.3.1",
    "base64-loader": "1.0.0",
    "bowser": "1.9.4",
    "classnames": "2.2.6",
    "clipcc-audio": "3.2.0",
    "clipcc-block": "3.2.0",
    "clipcc-l10n": "3.2.0",
    "clipcc-paint": "3.2.0",
    "clipcc-render": "3.2.0",
    "clipcc-storage": "3.2.0",
    "clipcc-svg-renderer": "3.2.0",
    "clipcc-vm": "3.2.0",
    "computed-style-to-inline-style": "3.0.0",
    "copy-webpack-plugin": "11.0.0",
    "core-js": "2.5.7",
    "css-loader": "6.7.3",
    "dapjs": "2.3.0",
    "es6-object-assign": "1.1.0",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "get-float-time-domain-data": "0.1.0",
    "get-user-media-promise": "1.1.4",
    "immutable": "3.8.2",
    "intl": "1.2.5",
    "js-base64": "2.4.9",
    "keymirror": "0.1.1",
    "lodash.bindall": "4.4.0",
    "lodash.debounce": "4.0.8",
    "lodash.defaultsdeep": "4.6.1",
    "lodash.omit": "4.5.0",
    "lodash.throttle": "4.0.1",
    "@turbowarp/nanolog": "^1.0.1",
    "node-polyfill-webpack-plugin": "^3.0.0",
    "omggif": "1.0.9",
    "papaparse": "5.3.0",
    "postcss-import": "^12.0.0",
    "postcss-loader": "7.0.2",
    "prop-types": "^15.5.10",
    "query-string": "^5.1.1",
    "react": "16.2.0",
    "react-contextmenu": "2.9.4",
    "react-dom": "16.2.1",
    "react-draggable": "3.0.5",
    "react-ga": "2.5.3",
    "react-intl": "2.9.0",
    "react-modal": "3.9.1",
    "react-popover": "0.5.10",
    "react-redux": "5.0.7",
    "react-responsive": "5.0.0",
    "react-style-proptype": "3.2.2",
    "react-tabs": "2.3.0",
    "react-tooltip": "3.8.0",
    "react-virtualized": "9.20.1",
    "redux": "3.7.2",
    "redux-throttle": "0.1.1",
    "scratch-render-fonts": "1.0.252",
    "startaudiocontext": "1.2.1",
    "style-loader": "3.3.1",
    "to-style": "1.3.3",
    "wav-encoder": "1.3.0",
    "xhr": "2.5.0"
  },
  "peerDependencies": {
    "react": "^16.0.0",
    "react-dom": "^16.0.0"
  },
  "devDependencies": {
    "@babel/cli": "7.28.6",
    "@babel/core": "7.29.0",
    "@babel/eslint-parser": "7.28.6",
    "@babel/plugin-proposal-object-rest-spread": "7.14.7",
    "@babel/plugin-syntax-dynamic-import": "7.2.0",
    "@babel/plugin-transform-async-to-generator": "7.14.5",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-react": "7.14.5",
    "@babel/preset-typescript": "^7.24.7",
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "10.0.3",
    "babel-jest": "23.6.0",
    "chromedriver": "107.0.3",
    "cross-fetch": "^3.1.8",
    "enzyme": "3.11.0",
    "enzyme-adapter-react-16": "1.15.7",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-import-resolver-webpack": "0.13.10",
    "eslint-plugin-import": "2.32.0",
    "globals": "^16.5.0",
    "eslint-plugin-jest": "22.17.0",
    "eslint-plugin-react": "7.37.5",
    "html-webpack-plugin": "^5.5.0",
    "jest": "21.2.1",
    "jest-junit": "7.0.0",
    "jest-localstorage-mock": "^2.4.26",
    "lumen5-web-audio-test-api": "0.5.2",
    "mkdirp": "1.0.3",
    "raf": "3.4.1",
    "react-test-renderer": "16.2.0",
    "redux-mock-store": "1.5.3",
    "rimraf": "2.7.1",
    "selenium-webdriver": "3.6.0",
    "terser-webpack-plugin": "^5.3.17",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.11.1",
    "yauzl": "2.10.0"
  },
  "jest": {
    "setupFiles": [
      "raf/polyfill",
      "<rootDir>/test/helpers/enzyme-setup.js"
    ],
    "testPathIgnorePatterns": [
      "src/test.js"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/test/__mocks__/fileMock.js",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)?\\?raw$": "<rootDir>/test/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/test/__mocks__/styleMock.js",
      "(blocks|editor)-msgs(\\.js)?$": "<rootDir>/test/__mocks__/editor-msgs-mock.js"
    }
  }
}
