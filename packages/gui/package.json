{
  "name": "clipcc-gui",
  "version": "3.2.0",
  "description": "Graphical User Interface for creating and running Scratch 3.0 projects",
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "main": "./dist/scratch-gui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/scratch-gui.js"
    },
    "./costumes": {
      "default": "./src/lib/libraries/costumes.json"
    },
    "./sprites": {
      "default": "./src/lib/libraries/sprites.json"
    },
    "./sounds": {
      "default": "./src/lib/libraries/sounds.json"
    },
    "./backdrops": {
      "default": "./src/lib/libraries/backdrops.json"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "yarn run clean && webpack --color --bail",
    "clean": "rimraf ./build && mkdirp build && rimraf ./dist && mkdirp dist",
    "deploy": "touch build/.nojekyll && gh-pages -t -d build -m \"[skip ci] Build for $(git log --pretty=format:%H -n1)\"",
    "prune": "./prune-gh-pages.sh",
    "i18n:push": "tx-push-src scratch-editor interface translations/en.json",
    "i18n:src": "rimraf ./translations/messages/src && babel src > tmp.js && rimraf tmp.js && node ./scripts/build-i18n-src.js ./translations/messages/src ./translations/",
    "start": "webpack-dev-server",
    "test": "yarn run test:unit && yarn run test:integration",
    "test:integration": "jest --maxWorkers=4 test[\\\\/]integration",
    "test:lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test:unit": "jest test[\\\\/]unit",
    "test:smoke": "jest --runInBand test[\\\\/]smoke",
    "watch": "webpack --color --watch"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@mediapipe/face_detection": "0.4.1646425229",
    "@radix-ui/react-context-menu": "^2.2.5",
    "@microbit/microbit-universal-hex": "0.2.2",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow/tfjs": "^4.22.0",
    "arraybuffer-loader": "1.0.8",
    "autoprefixer": "^9.8.8",
    "balance-text": "3.3.1",
    "base64-loader": "1.0.0",
    "bowser": "1.9.4",
    "classnames": "2.5.1",
    "clipcc-audio": "3.2.0",
    "clipcc-block": "3.2.0",
    "clipcc-l10n": "3.2.0",
    "clipcc-paint": "3.2.0",
    "clipcc-render": "3.2.0",
    "clipcc-storage": "3.2.0",
    "clipcc-svg-renderer": "3.2.0",
    "clipcc-vm": "3.2.0",
    "computed-style-to-inline-style": "3.0.0",
    "copy-webpack-plugin": "11.0.0",
    "core-js": "2.6.12",
    "css-loader": "6.7.3",
    "dapjs": "2.3.0",
    "driver.js": "1.3.6",
    "es6-object-assign": "1.1.0",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "get-float-time-domain-data": "0.1.0",
    "get-user-media-promise": "1.1.4",
    "immutable": "3.8.2",
    "intl": "1.2.5",
    "js-base64": "2.6.4",
    "keymirror": "0.1.1",
    "lodash.bindall": "4.4.0",
    "lodash.debounce": "4.0.8",
    "lodash.defaultsdeep": "4.6.1",
    "lodash.omit": "4.5.0",
    "lodash.throttle": "4.1.1",
    "minilog": "3.1.0",
    "node-polyfill-webpack-plugin": "^2.0.1",
    "omggif": "1.0.10",
    "papaparse": "5.5.3",
    "postcss-import": "^12.0.1",
    "postcss-loader": "7.0.2",
    "prop-types": "15.8.1",
    "query-string": "5.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-draggable": "3.0.5",
    "react-ga": "^3.3.1",
    "react-intl": "6.8.9",
    "react-modal": "^3.16.3",
    "react-popover": "0.5.10",
    "react-redux": "^8.0.0",
    "react-responsive": "9.0.0",
    "react-style-proptype": "3.2.2",
    "react-tabs": "^5.2.0",
    "react-tooltip": "4.5.1",
    "react-virtualized": "9.22.6",
    "react-visibility-sensor": "5.1.1",
    "redux": "4.2.1",
    "redux-throttle": "0.1.1",
    "scratch-render-fonts": "1.0.252",
    "startaudiocontext": "1.2.1",
    "style-loader": "3.3.1",
    "to-style": "1.3.3",
    "wav-encoder": "1.3.0",
    "xhr": "2.6.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-redux": "^8.0.0",
    "redux": "4.0.0"
  },
  "devDependencies": {
    "@babel/cli": "7.28.3",
    "@babel/core": "7.28.5",
    "@babel/eslint-parser": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "@testing-library/react": "14.3.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@types/react-modal": "^3.16.3",
    "@types/prop-types": "^15.7.15",
    "@babel/preset-typescript": "^7.28.5",
    "@commitlint/cli": "17.1.2",
    "@commitlint/config-conventional": "17.1.0",
    "babel-core": "7.0.0-bridge.0",
    "babel-loader": "10.0.0",
    "babel-eslint": "10.0.3",
    "babel-jest": "23.6.0",
    "chromedriver": "107.0.3",
    "cross-fetch": "^3.1.8",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-clipcc": "^9.0.9",
    "eslint-import-resolver-webpack": "0.13.10",
    "eslint-plugin-import": "2.32.0",
    "globals": "^16.5.0",
    "eslint-plugin-jest": "29.11.1",
    "eslint-plugin-react": "7.37.5",
    "gh-pages": "3.2.3",
    "html-webpack-plugin": "^5.6.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-junit": "7.0.0",
    "jest-localstorage-mock": "^2.4.26",
    "mkdirp": "1.0.4",
    "raf": "3.4.1",
    "react-test-renderer": "18.2.0",
    "redux-mock-store": "1.5.5",
    "rimraf": "2.7.1",
    "scratch-semantic-release-config": "1.0.5",
    "selenium-webdriver": "3.6.0",
    "semantic-release": "19.0.5",
    "terser-webpack-plugin": "^5.3.10",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "web-audio-test-api": "0.5.2",
    "yauzl": "3.2.0"
  },
  "jest": {
    "setupFiles": [
      "raf/polyfill"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-results"
        }
      ]
    ],
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "src/test.js"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)(\\?.*)?$": "<rootDir>/test/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/test/__mocks__/styleMock.js",
      "editor-msgs(\\.js)?$": "<rootDir>/test/__mocks__/editor-msgs-mock.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!intl-messageformat|intl-messageformat-parser).+\\.js$"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "tsx",
      "jsx"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": "<rootDir>/tsconfig.test.json"
        }
      ],
      "^.+\\.jsx?$": "babel-jest"
    }
  }
}
