// Reference: https://www.typescriptlang.org/docs/handbook/declaration-files/dts-from-js.html
{
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "node_modules",
        "./test/**/*"
    ],
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "jsx": "react",
        "outDir": "./dist/types/",
        "skipLibCheck": true
    }
}
