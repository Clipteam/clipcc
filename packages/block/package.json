{
  "name": "clipcc-block",
  "version": "3.2.0",
  "description": "Scratch Blocks is a library for building creative computing interfaces.",
  "author": "Massachusetts Institute of Technology",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "main": "./dist/vertical.js",
  "browser": "./shim/vertical.js",
  "scripts": {
    "start": "http-server ./ -s -p 0 -o /tests/vertical_playground.html -c-1",
    "deploy": "rimraf gh-pages/closure-library/scripts/ci/CloseAdobeDialog.exe && gh-pages -t -d gh-pages -m \"Build for $(git log --pretty=format:%H -n1) [skip ci]\"",
    "build": "gulp build && webpack",
    "test:unit": "node tests/jsunit/test_runner.js",
    "test:lint": "eslint .",
    "test:messages": "yarn run translate && node i18n/test_scratch_msgs.js",
    "test": "yarn run test:messages && yarn run test:unit",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\"",
    "translate": "node i18n/js_to_json.js && node i18n/json_to_js.js",
    "translate:sync:src": "tx-push-src scratch-editor blocks msg/json/en.json",
    "translate:sync:translations": "node i18n/sync_tx_translations.js",
    "translate:update": "yarn run translate:sync:src && yarn run translate:sync:translations"
  },
  "dependencies": {
    "clipcc-l10n": "3.2.0",
    "exports-loader": "^4.0.0",
    "google-closure-library": "20230802.0.0",
    "imports-loader": "^4.0.1"
  },
  "devDependencies": {
    "async": "2.6.4",
    "chromedriver": "105.0.1",
    "copy-webpack-plugin": "^11.0.0",
    "eslint": "4.19.1",
    "event-stream": "3.3.5",
    "gh-pages": "0.12.0",
    "glob": "^10.3.3",
    "google-closure-compiler": "20230802.0.0",
    "google-closure-deps": "20230802.0.0",
    "graceful-fs": "4.2.10",
    "gulp": "^4.0.2",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.4",
    "http-server": "^14.1.1",
    "json": "9.0.6",
    "rimraf": "2.7.1",
    "selenium-webdriver": "4.8.0",
    "terser-webpack-plugin": "^5.3.6",
    "transifex": "1.6.6",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  }
}
