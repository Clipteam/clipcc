{
  "name": "clipcc-vm",
  "version": "3.2.0",
  "description": "Virtual Machine for Scratch 3.0",
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "main": "./dist/node/scratch-vm.js",
  "browser": "./dist/web/scratch-vm.min.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build:types": "tsc --project ./tsconfig.dts.json",
    "build": "yarn build:types && webpack --progress --color --bail",
    "coverage": "tap ./test/{unit,integration}/*.js --coverage --coverage-report=lcov",
    "deploy": "touch playground/.nojekyll && gh-pages -t -d playground -m \"Build for $(git log -n1 --pretty=format:\"%h %s\") [skip ci]\"",
    "docs": "jsdoc -c .jsdoc.json",
    "i18n:src": "mkdirp translations/core && format-message extract --out-file translations/core/en.json src/extensions/**/index.js",
    "i18n:push": "tx-push-src scratch-editor extensions translations/core/en.json",
    "lint": "eslint . && format-message lint src/**/*.js",
    "prepublish": "in-publish && yarn build:types && yarn run build || not-in-publish",
    "start": "webpack-dev-server",
    "test": "tap ./test/{unit,integration}/*.js --allow-incomplete-coverage --allow-empty-coverage",
    "test:unit": "tap ./test/unit/*.js --allow-incomplete-coverage --allow-empty-coverage",
    "test:integration": "tap ./test/integration/*.js --allow-incomplete-coverage --allow-empty-coverage",
    "performance": "node ./test/extra/performance.js",
    "watch": "webpack --progress --color --watch",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\""
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@vernier/godirect": "1.5.0",
    "arraybuffer-loader": "1.0.8",
    "atob": "2.1.2",
    "btoa": "1.2.1",
    "canvas-toBlob": "1.0.0",
    "clipcc-parser": "3.2.0",
    "decode-html": "2.0.0",
    "diff-match-patch": "1.0.4",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "format-message": "6.2.1",
    "htmlparser2": "7.2.0",
    "immutable": "3.8.1",
    "jszip": "^3.1.5",
    "minilog": "3.1.0",
    "node-polyfill-webpack-plugin": "^2.0.1",
    "scratch-sb1-converter": "0.2.7",
    "scratch-translate-extension-languages": "0.0.20191118205314"
  },
  "peerDependencies": {
    "clipcc-svg-renderer": "^3.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.13.10",
    "@babel/eslint-parser": "7.18.2",
    "@babel/preset-env": "7.14.8",
    "@commitlint/cli": "17.0.2",
    "@commitlint/config-conventional": "17.0.2",
    "@types/fastestsmallesttextencoderdecoder": "^1.0.2",
    "adm-zip": "0.4.11",
    "babel-eslint": "10.1.0",
    "babel-loader": "^9.1.2",
    "callsite": "1.0.0",
    "clipcc-audio": "3.2.0",
    "clipcc-block": "3.2.0",
    "clipcc-l10n": "3.2.0",
    "clipcc-render": "3.2.0",
    "clipcc-storage": "3.2.0",
    "clipcc-svg-renderer": "3.2.0",
    "codingclip-worker-loader": "^3.0.9",
    "copy-webpack-plugin": "^11.0.0",
    "docdash": "1.2.0",
    "eslint": "5.3.0",
    "eslint-config-clipcc": "^9.0.9",
    "format-message-cli": "6.2.0",
    "gh-pages": "1.2.0",
    "in-publish": "2.0.1",
    "js-md5": "0.7.3",
    "jsdoc": "3.6.6",
    "json": "^9.0.4",
    "lodash.defaultsdeep": "4.6.1",
    "pngjs": "3.3.3",
    "scratch-render-fonts": "1.0.252",
    "scratch-semantic-release-config": "1.0.5",
    "script-loader": "0.7.2",
    "semantic-release": "19.0.5",
    "stats.js": "0.17.0",
    "tap": "21.0.1",
    "terser-webpack-plugin": "^5.3.10",
    "tiny-worker": "2.3.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.11.1"
  }
}
