{
  "name": "clipcc-vm",
  "version": "3.2.0",
  "description": "Virtual Machine for Scratch 3.0",
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "exports": {
    "types": "./dist/types/index.d.ts",
    "webpack": "./src/index.js",
    "node": "./dist/node/scratch-vm.js",
    "browser": "./dist/web/scratch-vm.min.js",
    "default": "./src/index.js"
  },
  "scripts": {
    "build:types": "tsc --project ./tsconfig.dts.json",
    "build": "pnpm run build:types && webpack --progress --color --bail",
    "coverage": "tap ./test/{unit,integration}/*.js --reporter=tap --coverage --coverage-report=lcov",
    "i18n:src": "mkdirp translations/core && format-message extract --out-file translations/core/en.json src/extensions/**/index.js",
    "lint": "pnpm run lint:js && format-message lint src/**/*.js",
    "lint:js": "eslint .",
    "prepublish": "in-publish && pnpm run build:types && pnpm run build || not-in-publish",
    "start": "webpack-dev-server",
    "test": "tap ./test/{unit,integration}/*.js --reporter=tap --allow-incomplete-coverage --allow-empty-coverage",
    "test:unit": "tap ./test/unit/*.js --reporter=tap --allow-incomplete-coverage --allow-empty-coverage",
    "test:integration": "tap ./test/integration/*.js --reporter=tap --allow-incomplete-coverage --allow-empty-coverage",
    "performance": "node ./test/extra/performance.js",
    "watch": "webpack --progress --color --watch",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\""
  },
  "dependencies": {
    "@turbowarp/nanolog": "^1.0.1",
    "@vernier/godirect": "1.5.0",
    "arraybuffer-loader": "1.0.8",
    "atob": "2.1.2",
    "btoa": "1.2.1",
    "canvas-toBlob": "1.0.0",
    "clipcc-parser": "workspace:~",
    "decode-html": "2.0.0",
    "diff-match-patch": "1.0.4",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "format-message": "^6.2.4",
    "htmlparser2": "10.1.0",
    "immutable": "5.1.5",
    "jszip": "^3.10.1",
    "node-polyfill-webpack-plugin": "^3.0.0",
    "scratch-sb1-converter": "1.0.324",
    "scratch-translate-extension-languages": "1.0.7"
  },
  "peerDependencies": {
    "clipcc-svg-renderer": "^3.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/eslint-parser": "7.28.6",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@types/fastestsmallesttextencoderdecoder": "^1.0.2",
    "@types/node": "^25.5.2",
    "adm-zip": "0.4.11",
    "babel-eslint": "10.1.0",
    "babel-loader": "^10.1.1",
    "callsite": "1.0.0",
    "clipcc-audio": "workspace:~",
    "clipcc-block": "workspace:~",
    "clipcc-extension": "workspace:~",
    "clipcc-l10n": "workspace:~",
    "clipcc-render": "workspace:~",
    "clipcc-storage": "workspace:~",
    "clipcc-svg-renderer": "workspace:~",
    "codingclip-worker-loader": "^3.0.10",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.39.2",
    "eslint-config-clipcc": "workspace:*",
    "format-message-cli": "6.2.4",
    "globals": "^16.5.0",
    "in-publish": "2.0.1",
    "js-md5": "0.7.3",
    "json": "^9.0.6",
    "lodash.defaultsdeep": "4.6.1",
    "pngjs": "7.0.0",
    "rule-inheritance-webpack-plugin": "^0.4.0",
    "scratch-render-fonts": "1.0.252",
    "script-loader": "0.7.2",
    "stats.js": "0.17.0",
    "tap": "21.0.1",
    "terser-webpack-plugin": "^5.3.17",
    "tiny-worker": "2.3.0",
    "typescript": "catalog:",
    "webpack": "catalog:",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "tap": {
    "tsconfig": "./tsconfig.test.json"
  }
}
