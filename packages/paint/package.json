{
  "name": "clipcc-paint",
  "version": "3.2.0",
  "description": "Graphical User Interface for the Scratch 3.0 paint editor, which is used to make and edit sprites for use in projects.",
  "main": "./dist/scratch-paint.js",
  "browser": "./src/index.js",
  "scripts": {
    "build": "yarn run clean && webpack --progress --color --bail",
    "clean": "rimraf ./dist && mkdirp dist && rimraf ./playground && mkdirp playground",
    "i18n:push": "tx-push-src scratch-editor paint-editor ./translations/en.json",
    "i18n:src": "rimraf ./translations/messages && babel src > tmp.js && rimraf tmp.js && ./scripts/build-i18n-source.js ./translations/messages/ ./translations/",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "prepare": "husky install",
    "start": "webpack-dev-server",
    "test": "yarn run lint && yarn run unit && NODE_ENV=production yarn run build",
    "unit": "jest --reporters=default",
    "watch": "webpack --progress --color --watch"
  },
  "author": "Clip Team",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Clipteam/clipcc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc.git"
  },
  "dependencies": {
    "@scratch/paper": "0.11.20200728195508",
    "classnames": "2.2.5",
    "keymirror": "0.1.1",
    "lodash.bindall": "4.4.0",
    "lodash.omit": "4.5.0",
    "minilog": "3.1.0",
    "parse-color": "1.0.0",
    "prop-types": "^15.5.10",
    "react-intl-redux": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18",
    "react-intl": "^6",
    "react-intl-redux": "^2.0.0",
    "react-popover": "^0.5",
    "react-redux": "^8",
    "react-responsive": "^9",
    "react-style-proptype": "^3",
    "react-tooltip": "^4",
    "redux": "^4",
    "scratch-render-fonts": "^1.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.14.8",
    "@babel/preset-react": "^7.14.5",
    "@commitlint/cli": "17.0.3",
    "@commitlint/config-conventional": "17.0.3",
    "autoprefixer": "9.7.4",
    "babel-cli": "6.26.0",
    "babel-core": "6.26.3",
    "babel-eslint": "10.1.0",
    "babel-jest": "23.6.0",
    "babel-loader": "^9.1.2",
    "babel-plugin-react-intl": "3.0.1",
    "css-loader": "^6.7.3",
    "eslint": "^9.39.2",
    "eslint-config-clipcc": "^9.0.9",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-react": "7.20.3",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "8.0.1",
    "jest": "22.4.4",
    "jest-canvas-mock": "2.3.1",
    "jest-junit": "13.0.0",
    "lodash.defaultsdeep": "4.6.1",
    "mkdirp": "1.0.4",
    "postcss-import": "12.0.1",
    "postcss-loader": "^7.0.2",
    "raf": "3.4.1",
    "react-test-renderer": "18.3.1",
    "redux-mock-store": "1.5.5",
    "redux-throttle": "0.1.1",
    "regenerator-runtime": "0.13.9",
    "rimraf": "2.7.1",
    "clipcc-l10n": "3.2.0",
    "scratch-render-fonts": "1.0.252",
    "style-loader": "^3.3.1",
    "svg-url-loader": "^8.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.11.1"
  },
   "jest": {
    "setupFiles": [
      "raf/polyfill"
    ],
    "testEnvironment": "jsdom",
    "testURL": "http://localhost",
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/test/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/test/__mocks__/styleMock.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!intl-messageformat|intl-messageformat-parser).+\\.js$"
    ]
  },
  "jest-junit": {
    "outputDirectory": "./test/results"
  },
  "browserslist": [
    "last 3 versions",
    "Safari >= 8",
    "iOS >= 8"
  ]
}
