{
  "name": "monorepo",
  "description": "ClipCC's Workspace",
  "private": true,
  "engines": {
    "node": ">=16"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "nohoist": [
      "**/google-closure-library",
      "**/google-closure-compiler",
      "**/google-closure-cmd"
    ]
  },
  "scripts": {
    "start": "yarn gui:start",
    "prepare": "husky install",
    "build:dist": "NODE_ENV=production yarn build:full",
    "build:full": "yarn l10n:build && yarn storage:build && yarn render:build && yarn block:build && yarn vm:build && yarn gui:build",
    "build": "yarn block:build && yarn gui:build",
    "test:unit": "yarn workspace scratch-gui test:unit && yarn workspace scratch-vm tap:unit",
    "translation:build": "yarn gui:translation && yarn vm:translation && yarn block:translation",
    "translation:push": "tx push",
    "translation:pull": "yarn workspace scratch-blocks translate:sync:translations && yarn workspace scratch-l10n pull:editor",
    "block:build": "yarn workspace scratch-blocks build",
    "block:translation": "yarn workspace scratch-blocks translate",
    "l10n:build": "yarn workspace scratch-l10n build",
    "gui:start": "yarn workspace scratch-gui start",
    "gui:build": "yarn workspace scratch-gui build",
    "gui:translation": "yarn workspace scratch-gui i18n:src",
    "vm:build": "yarn workspace scratch-vm build",
    "vm:docs": "yarn workspace scratch-vm docs",
    "vm:translation": "yarn workspace scratch-vm i18n:src",
    "vm:start": "yarn workspace scratch-vm start",
    "render:build": "yarn workspace scratch-render build",
    "storage:build": "yarn workspace scratch-storage build"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.2",
    "commitlint-config-gitmoji": "^2.2.10",
    "husky": "^8.0.3"
  }
}
